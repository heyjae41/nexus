# === EDU.AI service configuration (template) ===
# 복사해서 .env 로 저장한 뒤 환경에 맞게 수정하세요.

# --- Database (PostgreSQL) ---
DB_NAME=paybooc_ai
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache) ---
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=nexus:
CACHE_TTL_SECONDS=300

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Content ingest (Telegram -> /contents -> DB) ---
CONTENTS_DIR=./contents
INGEST_INTERVAL_SECONDS=60

# --- Media (영구 보관: 에디터 본문 이미지, 인제스트 썸네일) ---
# 배포 파드는 /app/media 에 S3 가 마운트되어 있고 백엔드 컨테이너 이미지(Dockerfile)가
# MEDIA_DIR=/app/media, MEDIA_REQUIRE_MOUNT=true 로 고정한다. 로컬은 마운트 없이 ./media 를 쓴다.
MEDIA_DIR=./media
MEDIA_REQUIRE_MOUNT=false

# --- Brunch collector ---
BRUNCH_COLLECT_INTERVAL_HOURS=12
BRUNCH_REF_QUERY=ref=nexus.bccard.ai
BRUNCH_BASE_URL=https://brunch.co.kr

# --- 수집 체인 (브런치 -> event-us -> luma 순차, 12시간 주기) ---
COLLECT_CHAIN_INTERVAL_HOURS=12
MEETUP_QUERY=ai ax
MEETUP_CATEGORIES=IT/프로그래밍,경제/금융
MEETUP_WINDOW_DAYS=14
LUMA_CATEGORIES=cat-ai:AI,cat-tech:TECH

# 쉼표로 구분한 닉네임만 권한관리에서 글쓰기 어드민을 지정한다
SUPER_ADMIN=heyjae
