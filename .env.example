# === NEXUS service configuration (template) ===
# 복사해서 .env 로 저장한 뒤 환경에 맞게 수정하세요.

# --- Database (PostgreSQL) ---
DB_NAME=paybooc_ai
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache) ---
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=nexus:
CACHE_TTL_SECONDS=300

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Content ingest (Telegram -> /contents -> DB) ---
CONTENTS_DIR=./contents
INGEST_INTERVAL_SECONDS=60

# --- Brunch collector ---
BRUNCH_COLLECT_INTERVAL_HOURS=12
BRUNCH_REF_QUERY=ref=nexus.bccard.ai
BRUNCH_BASE_URL=https://brunch.co.kr
