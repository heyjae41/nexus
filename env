# === NEXUS service configuration (local) ===
# 이 파일은 git에 커밋되지 않습니다. 배포 시 서버별로 작성하세요. (.env.example 참고)

# --- Database (PostgreSQL) ---
DB_NAME=paybooc_ai
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache) ---
REDIS_URL=redis://localhost:6379/0
CACHE_PREFIX=nexus:
CACHE_TTL_SECONDS=300

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Content ingest (Telegram -> /contents -> DB) ---
CONTENTS_DIR=./contents
INGEST_INTERVAL_SECONDS=60

# --- Brunch collector ---
BRUNCH_COLLECT_INTERVAL_HOURS=12
BRUNCH_REF_QUERY=ref=nexus.bccard.ai
BRUNCH_BASE_URL=https://brunch.co.kr

# --- 수집 체인 (브런치 -> event-us -> luma 순차, 12시간 주기) ---
COLLECT_CHAIN_INTERVAL_HOURS=12
MEETUP_QUERY=ai ax
MEETUP_CATEGORIES=IT/프로그래밍,경제/금융
MEETUP_WINDOW_DAYS=14
LUMA_CATEGORIES=cat-ai:AI,cat-tech:TECH
